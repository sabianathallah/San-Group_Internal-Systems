NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sangroup_dev"

# JWT Secrets — min 32 karakter, gunakan string acak yang kuat di production
JWT_SECRET="ganti_dengan_random_string_min_32_karakter"
JWT_REFRESH_SECRET="ganti_dengan_random_string_lain_min_32_karakter"

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# URL frontend untuk CORS
CORS_ORIGIN=http://localhost:5173

# Folder penyimpanan file upload
UPLOAD_DIR=./uploads
