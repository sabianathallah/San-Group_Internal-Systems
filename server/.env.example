# Database
# Local  : postgresql://user:password@localhost:5432/san_group_db
# Railway: otomatis diisi dari Railway PostgreSQL service
DATABASE_URL="postgresql://user:password@localhost:5432/san_group_db"

# Server
PORT=3000
NODE_ENV=development

# CORS
# Local       : http://localhost:5173
# Production  : https://<nama-project>.vercel.app
CORS_ORIGIN=http://localhost:5173

# JWT (min 32 karakter, gunakan random string)
JWT_SECRET=your_jwt_secret_here_min_32_chars_xxxxxxxxxxxx
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars_xxxxxxxx
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Upload
UPLOAD_DIR=./uploads
