NODE_ENV=test
PORT=3001

# Database test terpisah — jangan pakai DB dev
DATABASE_URL="postgresql://postgres@localhost/sangroup_test?host=/tmp"

# JWT Secrets (boleh sama dengan dev untuk test)
JWT_SECRET="san_group_jwt_secret_key_dev_2026_x9z!"
JWT_REFRESH_SECRET="san_group_refresh_secret_dev_2026_k7w@"

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Cloudinary is only required by env validation at startup — no test
# exercises real uploads, so dummy values are sufficient here.
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=test-key
CLOUDINARY_API_SECRET=test-secret
