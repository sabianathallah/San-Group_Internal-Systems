generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BulletinCategory {
  ANNOUNCEMENT
  HOLIDAY
  MAINTENANCE
  EVENT
  GENERAL
}

enum BulletinPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_CREATED
  BULLETIN_NEW
  BULLETIN_URGENT
  SYSTEM
  TASK_DUE_SOON
  TASK_OVERDUE
  WO_ASSIGNED
  WO_STATUS_CHANGED
  WO_COMPLETED
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  // Legacy — overtime module removed (client policy: no overtime); values kept
  // because removing PG enum values requires a type rebuild.
  OVERTIME_SUBMITTED
  OVERTIME_APPROVED
  OVERTIME_REJECTED
}

enum AttendanceStatus {
  PRESENT
  LATE
  WFH
  PERMISSION
  ABSENT
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Shared by ShiftChangeRequest and LateExcuseRequest — same review lifecycle
// as leave/overtime.
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkOrderStatus {
  OPEN
  VALIDATED
  ASSIGNED
  IN_PROGRESS
  PENDING_PARTS
  PENDING_REVIEW
  DONE
  CANCELLED
}

enum WorkOrderAttachmentType {
  BEFORE
  AFTER
  OTHER
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderCategory {
  ELECTRICAL
  PLUMBING
  HVAC
  CIVIL
  CLEANING
  SECURITY
  OTHER
}

enum TaskVisibility {
  PRIVATE
  DIVISION
  DIVISION_SELECT
  PUBLIC
}

enum AudienceType {
  ALL
  DIVISION
  CUSTOM
}

enum RecurrenceType {
  DAILY
  WEEKDAYS
  WEEKLY
}

// ============================================================
// PHASE 1 — ACTIVE TABLES
// ============================================================

// --- Division & Role (dynamic tables) ---

model Division {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6366f1")
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  roles              Role[]
  bulletinAudiences              BulletinAudience[]
  dbFolders                      DatabaseFolder[]       @relation("FolderDivision")
  taskDivisionAccess             TaskDivisionAccess[]
  scheduledAnnouncementAudiences ScheduledAnnouncementAudience[]

  @@map("divisions")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  color       String    @default("#6366f1")
  level       Int       @default(6)
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  users          User[]
  rolePermission RolePermission?

  @@map("roles")
  @@index([divisionId])
}

// --- User & Auth ---

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  username    String    @unique
  password    String
  fullName    String
  phone       String?
  avatar      String?
  wallpaperType  String?   // 'preset' | 'custom' — homepage header background
  wallpaperValue String?   // preset key, or Cloudinary URL when wallpaperType = 'custom'
  isActive    Boolean   @default(true)
  joinDate    DateTime? @db.Date // tanggal mulai kerja — dasar aturan tenure cuti
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  shiftId    String?
  shift      Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  // Relations
  refreshTokens      RefreshToken[]
  tasks              Task[]              @relation("TaskCreator")
  assignedTasks      Task[]              @relation("TaskAssignee")
  taskAttachments    TaskAttachment[]
  stickyNotes        StickyNote[]
  taskLists          TaskList[]
  bulletins          Bulletin[]
  bulletinReadStatus BulletinReadStatus[]
  notifications      Notification[]      @relation("NotificationRecipient")
  triggeredNotifs    Notification[]      @relation("NotificationActor")
  databaseLinks      DatabaseLink[]
  databaseFolders    DatabaseFolder[]
  taskComments        TaskComment[]
  grantedShares       ResourceShare[]
  auditLogs           AuditLog[]
  taskListMemberships        TaskListMembership[]
  scheduledAnnouncements     ScheduledAnnouncement[]
  reportedWorkOrders         WorkOrder[]             @relation("WOReporter")
  assignedWorkOrders         WorkOrder[]             @relation("WOAssignee")
  assignedByMeWorkOrders     WorkOrder[]             @relation("WOAssigner")
  reviewedWorkOrders         WorkOrder[]             @relation("WOReviewer")
  workOrderHistories         WorkOrderHistory[]
  workOrderAttachments       WorkOrderAttachment[]
  attendances                Attendance[]
  leaveRequests              LeaveRequest[]          @relation("LRRequester")
  reviewedLeaveRequests      LeaveRequest[]          @relation("LRReviewer")
  leaveBalances              LeaveBalance[]
  shiftChangeRequests        ShiftChangeRequest[]    @relation("SCRRequester")
  reviewedShiftChanges       ShiftChangeRequest[]    @relation("SCRReviewer")
  lateExcuseRequests         LateExcuseRequest[]     @relation("LERRequester")
  reviewedLateExcuses        LateExcuseRequest[]     @relation("LERReviewer")
  compOffGrants              CompOffGrant[]          @relation("COGUser")
  grantedCompOffs            CompOffGrant[]          @relation("COGGrantedBy")

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@index([divisionId])
  @@index([shiftId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// --- Tasks / To-Do ---

model TaskList {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  icon      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  memberships TaskListMembership[]

  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  isImportant Boolean      @default(false)
  myDayDate   DateTime?    @db.Date
  dueDate          DateTime?
  startedAt        DateTime? // first move to IN_PROGRESS — basis of work-duration tracking
  completedAt      DateTime?
  isPrivate        Boolean           @default(false)
  visibility       TaskVisibility    @default(PRIVATE)
  assignmentStatus AssignmentStatus?
  assignmentNote   String?
  position         Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  userId       String
  creator      User   @relation("TaskCreator", fields: [userId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignee     User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  listId   String?
  taskList TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  // Self-referencing for sub-tasks
  parentTaskId String?
  parentTask   Task?   @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks     Task[]  @relation("SubTasks")

  attachments        TaskAttachment[]
  links              TaskLink[]
  comments           TaskComment[]
  divisionAccess     TaskDivisionAccess[]
  listMemberships    TaskListMembership[]

  @@index([userId])
  @@index([assignedToId])
  @@index([listId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([myDayDate])
  @@index([isImportant])
}

model TaskAttachment {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedById])
}

model TaskLink {
  id        String   @id @default(uuid())
  url       String
  title     String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
}

model TaskDivisionAccess {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([taskId, divisionId])
  @@index([taskId])
  @@index([divisionId])
  @@map("task_division_access")
}

model TaskListMembership {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  listId    String
  taskList  TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
  @@index([listId])
  @@map("task_list_memberships")
}

// --- Sticky Notes ---

model StickyNote {
  id        String   @id @default(uuid())
  title     String?
  content   String
  color     String   @default("yellow")
  isPinned  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPinned])
}

// --- Bulletin Board ---

model Bulletin {
  id          String           @id @default(uuid())
  title       String
  content     String
  category    BulletinCategory @default(GENERAL)
  priority    BulletinPriority @default(NORMAL)
  isPublished  Boolean          @default(false)
  audienceType AudienceType     @default(ALL)
  publishedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  attachments BulletinAttachment[]
  readStatus  BulletinReadStatus[]
  audiences   BulletinAudience[]

  @@index([authorId])
  @@index([category])
  @@index([priority])
  @@index([isPublished])
  @@index([publishedAt])
}

model BulletinAttachment {
  id        String   @id @default(uuid())
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  @@index([bulletinId])
}

model BulletinReadStatus {
  id     String   @id @default(uuid())
  readAt DateTime @default(now())

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, userId])
  @@index([bulletinId])
  @@index([userId])
}

// --- Database Section (Folder & Link Management) ---

model DatabaseFolder {
  id          String   @id @default(uuid())
  name        String
  icon        String?
  color       String   @default("#6366f1")
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  links       DatabaseLink[]

  divisionId  String?
  division    Division?      @relation("FolderDivision", fields: [divisionId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([divisionId])
}

model DatabaseLink {
  id          String   @id @default(uuid())
  title       String
  url         String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folderId    String
  folder      DatabaseFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([createdById])
}

// --- Notifications ---

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorId])
  @@index([isRead])
  @@index([type])
}

model RolePermission {
  id          String   @id @default(uuid())
  roleId      String   @unique
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissions Json     @default("{}")
  updatedAt   DateTime @updatedAt

  @@map("role_permissions")
}

model BulletinAudience {
  id         String   @id @default(uuid())
  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, divisionId])
  @@index([bulletinId])
  @@index([divisionId])
  @@map("bulletin_audiences")
}

model ScheduledAnnouncement {
  id          String         @id @default(uuid())
  title       String
  content     String
  audienceType AudienceType  @default(ALL)
  recurrence  RecurrenceType
  dayOfWeek   Int?
  sendHour    Int
  sendMinute  Int            @default(0)
  isActive    Boolean        @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdById String
  createdBy   User                           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  audiences   ScheduledAnnouncementAudience[]

  @@index([createdById])
  @@index([isActive])
  @@map("scheduled_announcements")
}

model ScheduledAnnouncementAudience {
  id                      String               @id @default(uuid())
  scheduledAnnouncementId String
  scheduledAnnouncement   ScheduledAnnouncement @relation(fields: [scheduledAnnouncementId], references: [id], onDelete: Cascade)
  divisionId              String
  division                Division             @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([scheduledAnnouncementId, divisionId])
  @@index([scheduledAnnouncementId])
  @@index([divisionId])
  @@map("scheduled_announcement_audiences")
}

model ResourceShare {
  id           String   @id @default(uuid())
  resourceType String
  resourceId   String
  targetType   String
  targetId     String
  grantedById  String
  grantedBy    User     @relation(fields: [grantedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([resourceType, resourceId, targetType, targetId])
  @@index([resourceType, resourceId])
  @@index([grantedById])
  @@map("resource_shares")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String?
  detail     Json?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// PHASE 2 — COMMENTED OUT (uncomment saat Phase 2 dimulai)
// ============================================================

// --- Work Order System ---

model WorkOrder {
  id          String            @id @default(uuid())
  code        String            @unique // auto-generated, e.g. WO/2026/001
  title       String
  description String?
  status      WorkOrderStatus   @default(OPEN)
  priority    WorkOrderPriority @default(MEDIUM)
  category    WorkOrderCategory @default(OTHER)
  location    String?
  dueDate     DateTime?
  completedAt DateTime?
  closedAt    DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  reportedById String
  reportedBy   User   @relation("WOReporter", fields: [reportedById], references: [id])

  assignedToId String?
  assignee     User?   @relation("WOAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedById String?
  assignedBy   User?   @relation("WOAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime?

  reviewedById String?
  reviewedBy   User?     @relation("WOReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNotes  String?

  history     WorkOrderHistory[]
  attachments WorkOrderAttachment[]

  @@index([reportedById])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([reviewedById])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@map("work_orders")
}

// Atomic per-year counter backing WorkOrder.code (WO/{year}/{seq}).
model WorkOrderSequence {
  year    Int @id
  counter Int @default(0)

  @@map("work_order_sequences")
}

model WorkOrderHistory {
  id          String           @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus
  note        String?
  changedById String
  changedBy   User             @relation(fields: [changedById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([workOrderId])
  @@index([changedById])
  @@map("work_order_history")
}

model WorkOrderAttachment {
  id           String                  @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder               @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type         WorkOrderAttachmentType @default(OTHER)
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  uploadedById String
  uploadedBy   User                    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime                @default(now())

  @@index([workOrderId])
  @@index([type])
  @@map("work_order_attachments")
}

// --- HRIS ---

model LeaveType {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6366f1")
  maxDaysPerYear Int   @default(0) // 0 = unlimited
  isPaid      Boolean  @default(true)
  requiresDoc Boolean  @default(false)
  // Doc only mandatory when totalDays exceeds this (SICK: 1 -> doc needed for >1 day; 0 -> always)
  requiresDocAfterDays Int @default(0)
  // Unused balance carries into next year, usable until March 31 then expires
  allowCarryOver Boolean @default(false)
  // Minimum months of tenure before this quota applies; below it requests become unpaid
  tenureMonthsRequired Int @default(0)
  // Balance starts at 0 and is earned via comp-off grants instead of a yearly quota
  earnedBalance Boolean @default(false)
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  totalDays   Int
  usedDays    Int       @default(0)
  pendingDays Int       @default(0)
  // Portion of totalDays that came from last year's remainder; zeroed (and the
  // unused part removed from totalDays) after March 31
  carriedOverDays Int   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([leaveTypeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation("LRRequester", fields: [userId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  totalDays    Int
  reason       String
  status       LeaveStatus @default(PENDING)
  // Tenure below the leave type's requirement: no quota deducted, salary cut applies
  isUnpaid     Boolean     @default(false)
  attachmentUrl  String?
  attachmentName String?
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?       @relation("LRReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([leaveTypeId])
  @@index([status])
  @@map("leave_requests")
}

// Audit trail of comp-off ("ganti off") credits: HR grants extra off days for
// working weekends/holidays; the days land on the earned-balance leave type.
model CompOffGrant {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("COGUser", fields: [userId], references: [id], onDelete: Cascade)
  days        Int
  reason      String
  grantedById String
  grantedBy   User     @relation("COGGrantedBy", fields: [grantedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("comp_off_grants")
}

model Shift {
  id                   String   @id @default(uuid())
  name                 String   @unique
  startTime            String
  endTime              String
  lateThresholdMinutes Int      @default(0)
  isDefault            Boolean  @default(false)
  color                String   @default("#6366f1")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users       User[]
  attendances Attendance[]
  shiftChangeRequests ShiftChangeRequest[] @relation("SCRRequestedShift")

  @@map("shifts")
}

model OfficeLocation {
  id           String   @id @default(uuid())
  name         String
  address      String?
  lat          Float
  lng          Float
  radiusMeters Int      @default(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendances Attendance[]

  @@map("office_locations")
}

model Attendance {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime         @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  status           AttendanceStatus @default(PRESENT)
  note             String?
  isLate           Boolean          @default(false)
  lateMinutes      Int              @default(0)
  workMinutes      Int?
  lat              Float?
  lng              Float?
  locationName     String?
  isOutOfArea      Boolean          @default(false)
  outOfAreaReason  String?
  shiftId          String?
  shift            Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  officeLocationId String?
  officeLocation   OfficeLocation?  @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  photoUrl         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt


  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([shiftId])
  @@index([officeLocationId])
  @@map("attendance")
}

// Company holiday calendar (tanggal merah). Consulted by leave-day counting,
// the auto-absent job, and attendance-rate reports so all three agree on
// which days count as working days.
model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())

  @@map("holidays")
}

// Staff-initiated shift/timetable change, reviewed by HR — the "apply
// perubahan jadwal ke HRD, approve/reject" flow from the contract scope.
// Approval applies requestedShift to the user starting effectiveDate.
model ShiftChangeRequest {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation("SCRRequester", fields: [userId], references: [id], onDelete: Cascade)
  requestedShiftId String
  requestedShift   Shift         @relation("SCRRequestedShift", fields: [requestedShiftId], references: [id])
  effectiveDate    DateTime      @db.Date
  reason           String
  status           RequestStatus @default(PENDING)
  reviewNote       String?
  reviewedById     String?
  reviewedBy       User?         @relation("SCRReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("shift_change_requests")
}

// Advance notice of lateness (izin telat di muka) — submitted BEFORE
// check-in for known cases (e.g. morning doctor visit). An APPROVED excuse
// for the date makes that day's check-in count as on time.
model LateExcuseRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation("LERRequester", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  expectedTime String?
  reason       String
  status       RequestStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?         @relation("LERReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("late_excuse_requests")
}


