generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BulletinCategory {
  ANNOUNCEMENT
  HOLIDAY
  MAINTENANCE
  EVENT
  GENERAL
}

enum BulletinPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  BULLETIN_NEW
  BULLETIN_URGENT
  SYSTEM
  TASK_DUE_SOON
  TASK_OVERDUE
}

enum TaskVisibility {
  PRIVATE
  DIVISION
  PUBLIC
}

enum AudienceType {
  ALL
  DIVISION
  CUSTOM
}

// ============================================================
// PHASE 1 — ACTIVE TABLES
// ============================================================

// --- Division & Role (dynamic tables) ---

model Division {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6366f1")
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  roles            Role[]
  bulletinAudiences BulletinAudience[]
  dbFolders        DatabaseFolder[]    @relation("FolderDivision")

  @@map("divisions")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  color       String    @default("#6366f1")
  level       Int       @default(6)
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  users          User[]
  rolePermission RolePermission?

  @@map("roles")
  @@index([divisionId])
}

// --- User & Auth ---

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  username    String    @unique
  password    String
  fullName    String
  phone       String?
  avatar      String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  // Relations
  refreshTokens      RefreshToken[]
  tasks              Task[]              @relation("TaskCreator")
  assignedTasks      Task[]              @relation("TaskAssignee")
  taskAttachments    TaskAttachment[]
  stickyNotes        StickyNote[]
  taskLists          TaskList[]
  bulletins          Bulletin[]
  bulletinReadStatus BulletinReadStatus[]
  notifications      Notification[]      @relation("NotificationRecipient")
  triggeredNotifs    Notification[]      @relation("NotificationActor")
  databaseLinks      DatabaseLink[]
  databaseFolders    DatabaseFolder[]
  taskComments       TaskComment[]
  grantedShares      ResourceShare[]
  auditLogs          AuditLog[]

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@index([divisionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// --- Tasks / To-Do ---

model TaskList {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  icon      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  isImportant Boolean      @default(false)
  myDayDate   DateTime?    @db.Date
  dueDate          DateTime?
  completedAt      DateTime?
  isPrivate        Boolean           @default(false)
  visibility       TaskVisibility    @default(PRIVATE)
  assignmentStatus AssignmentStatus?
  assignmentNote   String?
  position         Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  userId       String
  creator      User   @relation("TaskCreator", fields: [userId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignee     User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  listId   String?
  taskList TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  // Self-referencing for sub-tasks
  parentTaskId String?
  parentTask   Task?   @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks     Task[]  @relation("SubTasks")

  attachments TaskAttachment[]
  links       TaskLink[]
  comments    TaskComment[]

  @@index([userId])
  @@index([assignedToId])
  @@index([listId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([myDayDate])
  @@index([isImportant])
}

model TaskAttachment {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedById])
}

model TaskLink {
  id        String   @id @default(uuid())
  url       String
  title     String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
}

// --- Sticky Notes ---

model StickyNote {
  id        String   @id @default(uuid())
  title     String?
  content   String
  color     String   @default("yellow")
  isPinned  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPinned])
}

// --- Bulletin Board ---

model Bulletin {
  id          String           @id @default(uuid())
  title       String
  content     String
  category    BulletinCategory @default(GENERAL)
  priority    BulletinPriority @default(NORMAL)
  isPublished  Boolean          @default(false)
  audienceType AudienceType     @default(ALL)
  publishedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  attachments BulletinAttachment[]
  readStatus  BulletinReadStatus[]
  audiences   BulletinAudience[]

  @@index([authorId])
  @@index([category])
  @@index([priority])
  @@index([isPublished])
  @@index([publishedAt])
}

model BulletinAttachment {
  id        String   @id @default(uuid())
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  @@index([bulletinId])
}

model BulletinReadStatus {
  id     String   @id @default(uuid())
  readAt DateTime @default(now())

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, userId])
  @@index([bulletinId])
  @@index([userId])
}

// --- Database Section (Folder & Link Management) ---

model DatabaseFolder {
  id          String   @id @default(uuid())
  name        String
  icon        String?
  color       String   @default("#6366f1")
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  links       DatabaseLink[]

  divisionId  String?
  division    Division?      @relation("FolderDivision", fields: [divisionId], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([divisionId])
}

model DatabaseLink {
  id          String   @id @default(uuid())
  title       String
  url         String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folderId    String
  folder      DatabaseFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([createdById])
}

// --- Notifications ---

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorId])
  @@index([isRead])
  @@index([type])
}

model RolePermission {
  id          String   @id @default(uuid())
  roleId      String   @unique
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissions Json     @default("{}")
  updatedAt   DateTime @updatedAt

  @@map("role_permissions")
}

model BulletinAudience {
  id         String   @id @default(uuid())
  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, divisionId])
  @@index([bulletinId])
  @@index([divisionId])
  @@map("bulletin_audiences")
}

model ResourceShare {
  id           String   @id @default(uuid())
  resourceType String
  resourceId   String
  targetType   String
  targetId     String
  grantedById  String
  grantedBy    User     @relation(fields: [grantedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([resourceType, resourceId, targetType, targetId])
  @@index([resourceType, resourceId])
  @@index([grantedById])
  @@map("resource_shares")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entity     String
  entityId   String?
  detail     Json?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

