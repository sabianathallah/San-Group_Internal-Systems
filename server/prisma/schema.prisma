generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
  DIRECTOR
  PROPERTY_MANAGER
  LEASING_MANAGER
  LEASING_ASSISTANT
  LEASING_STAFF
  TENANT_RELATIONS
  FACILITY_MANAGER
  CHIEF_ENGINEER
  ENGINEER
  FINANCE_MANAGER
  ASST_FINANCE_MANAGER
  ACCOUNTANT
  LEGAL_HEAD
  LEGAL_SPV
  LEGAL_STAFF
  TAX_STAFF
  HR_MANAGER
  HR_SPV
  HR_STAFF
  FNB_MANAGER
  GA_MANAGER
  STAFF
}

enum Division {
  MANAGEMENT
  RETAIL
  HOTEL
  HOUSING
  FNB
  GENERAL
  LEASING
  PROPERTY
  ENGINEERING
  FINANCE
  LEGAL
  TAX
  HR
  GA
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCategory {
  MY_DAY
  IMPORTANT
  PLANNED
  CUSTOM
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BulletinCategory {
  ANNOUNCEMENT
  HOLIDAY
  MAINTENANCE
  EVENT
  GENERAL
}

enum BulletinPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  BULLETIN_NEW
  BULLETIN_URGENT
  SYSTEM
}

// ============================================================
// PHASE 1 — ACTIVE TABLES
// ============================================================

// --- User & Auth ---

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  username    String    @unique
  password    String
  fullName    String
  phone       String?
  avatar      String?
  role        Role      @default(STAFF)
  division    Division
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  refreshTokens      RefreshToken[]
  tasks              Task[]              @relation("TaskCreator")
  assignedTasks      Task[]              @relation("TaskAssignee")
  taskAttachments    TaskAttachment[]
  stickyNotes        StickyNote[]
  taskLists          TaskList[]
  bulletins          Bulletin[]
  bulletinReadStatus BulletinReadStatus[]
  notifications      Notification[]      @relation("NotificationRecipient")
  triggeredNotifs    Notification[]      @relation("NotificationActor")
  databaseLinks      DatabaseLink[]
  databaseFolders    DatabaseFolder[]
  taskComments       TaskComment[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([division])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// --- Tasks / To-Do ---

model TaskList {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#6366f1")
  icon      String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@index([userId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  category    TaskCategory @default(MY_DAY)
  dueDate          DateTime?
  completedAt      DateTime?
  isPrivate        Boolean           @default(false)
  assignmentStatus AssignmentStatus?
  assignmentNote   String?
  position         Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  userId       String
  creator      User   @relation("TaskCreator", fields: [userId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignee     User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  listId   String?
  taskList TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  // Self-referencing for sub-tasks
  parentTaskId String?
  parentTask   Task?   @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks     Task[]  @relation("SubTasks")

  attachments TaskAttachment[]
  links       TaskLink[]
  comments    TaskComment[]

  @@index([userId])
  @@index([assignedToId])
  @@index([listId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model TaskAttachment {
  id         String   @id @default(uuid())
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedById])
}

model TaskLink {
  id        String   @id @default(uuid())
  url       String
  title     String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
}

// --- Sticky Notes ---

model StickyNote {
  id        String   @id @default(uuid())
  title     String?
  content   String
  color     String   @default("yellow")
  isPinned  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPinned])
}

// --- Bulletin Board ---

model Bulletin {
  id          String           @id @default(uuid())
  title       String
  content     String
  category    BulletinCategory @default(GENERAL)
  priority    BulletinPriority @default(NORMAL)
  isPublished Boolean          @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  attachments BulletinAttachment[]
  readStatus  BulletinReadStatus[]

  @@index([authorId])
  @@index([category])
  @@index([priority])
  @@index([isPublished])
  @@index([publishedAt])
}

model BulletinAttachment {
  id        String   @id @default(uuid())
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  @@index([bulletinId])
}

model BulletinReadStatus {
  id     String   @id @default(uuid())
  readAt DateTime @default(now())

  bulletinId String
  bulletin   Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bulletinId, userId])
  @@index([bulletinId])
  @@index([userId])
}

// --- Database Section (Folder & Link Management) ---

model DatabaseFolder {
  id          String   @id @default(uuid())
  name        String
  icon        String?
  color       String   @default("#6366f1")
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  links       DatabaseLink[]

  @@index([createdById])
}

model DatabaseLink {
  id          String   @id @default(uuid())
  title       String
  url         String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folderId    String
  folder      DatabaseFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([createdById])
}

// --- Notifications ---

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorId])
  @@index([isRead])
  @@index([type])
}

